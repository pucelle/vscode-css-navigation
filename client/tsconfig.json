{
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "Node16",
		"moduleDetection": "legacy",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "esnext",
		"outDir": "out",
		"rootDir": "src",
		"lib": [
			"esnext"
		],
		"sourceMap": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noImplicitThis": true,
		"declaration": true,
		"composite": true,
		"types": [
			"node"
		]
	},
	"include": [
		"src"
	],
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}
